# ==========================================
# BYOK Multi-Device Central Vault Deployment Keys
# ==========================================
# When deploying to Vercel, Railway, Render, Docker, or AWS,
# you can set these environment variables in your deployment dashboard.
# Any device or browser opening your deployed app will automatically
# have access to these configured models and keys!

# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (accesses all 26+ curated open & frontier models)
OPENROUTER_API_KEY=

# Demon Route API Key (OpenAI-compatible, 1,300+ open-weight models)
DEMONROUTE_API_KEY=

# OpenAI API Key (GPT-4o, o1, o3, etc.)
OPENAI_API_KEY=

# Anthropic API Key (Claude 3.7 Sonnet, Claude 3.5 Haiku, etc.)
ANTHROPIC_API_KEY=

# DeepSeek API Key (DeepSeek V3, DeepSeek R1)
DEEPSEEK_API_KEY=

# Together AI API Key
TOGETHER_API_KEY=

# Mistral AI API Key
MISTRAL_API_KEY=
